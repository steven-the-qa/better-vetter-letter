---

---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/logo.png" />
    <meta name="viewport" content="width=device-width" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900;1,14..32,100..900&family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap"
      rel="stylesheet"
    />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content="Welcome to Better Vetter Newsletter" />
    <title>Welcome - Better Vetter Newsletter</title>
    <style>
      @keyframes shimmer {
        0% {
          background-position: -200% center;
        }
        100% {
          background-position: 200% center;
        }
      }
    </style>
  </head>
  <body class="bg-dark-gray font-sans leading-relaxed text-text-light">
    <header
      class="border-b border-light-blue/20 bg-dark-gray/95 backdrop-blur-sm"
    >
      <div
        class="mx-auto flex max-w-4xl flex-nowrap items-center gap-3 whitespace-nowrap px-6 py-4 md:px-4"
      >
        <img
          src="/logo.png"
          alt=""
          class="h-8 w-auto shrink-0 sm:h-9"
          width="auto"
          height="36"
        />
        <span
          class="text-lg font-bold tracking-tight text-text-light sm:text-xl"
          >Better Vetter Newsletter</span
        >
      </div>
    </header>
    <div class="mx-auto max-w-4xl px-8 py-16 md:px-4">
      <div class="mb-20 text-center">
        <h1
          class="mb-4 text-5xl font-bold tracking-tight text-text-light md:text-6xl lg:text-7xl"
        >
          Welcome to the newsletter!
        </h1>
        <p
          class="mb-4 text-xl font-light text-light-pink md:text-2xl lg:text-3xl"
        >
          So excited you're here 🎉
        </p>
      </div>

      <div
        class="my-16 rounded-lg border-2 border-light-blue bg-light-blue/10 p-8 text-center"
      >
        <p class="mb-4 text-lg font-semibold text-light-blue">Come say hi 👋</p>
        <div class="flex justify-center gap-6">
          <a
            href="https://www.linkedin.com/in/jaclynlilly/"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block rounded-lg border-2 border-light-blue bg-light-blue px-6 py-2 font-semibold text-dark-gray no-underline transition-all duration-300 ease-in-out hover:-translate-y-0.5 hover:bg-light-blue/90"
            >JL2💞</a
          >
          <a
            href="https://www.linkedin.com/in/stevenboutcher/"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block rounded-lg border-2 border-light-blue bg-light-blue px-6 py-2 font-semibold text-dark-gray no-underline transition-all duration-300 ease-in-out hover:-translate-y-0.5 hover:bg-light-blue/90"
            >SB🐒</a
          >
        </div>
      </div>

      <div
        class="my-16 rounded-lg border-l-4 border-light-pink bg-medium-gray p-8"
      >
        <p class="mb-4 text-lg text-text-light">
          You're in. Twice a week, we'll send you real stories and actionable
          strategies to help you run a smarter job search.
        </p>
        <p class="mb-0 text-light-pink">
          Mondays we name the problem. Fridays we fix it.
        </p>
      </div>
    </div>
  </body>
</html>
