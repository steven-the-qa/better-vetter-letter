---
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900;1,14..32,100..900&family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap"
      rel="stylesheet"
    />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content="Welcome to Better Vetter Newsletter" />
    <title>Welcome - Better Vetter Newsletter</title>
    <style>
      @keyframes shimmer {
        0% {
          background-position: -200% center;
        }
        100% {
          background-position: 200% center;
        }
      }
    </style>
  </head>
  <body class="bg-dark-gray font-sans leading-relaxed text-text-light">
    <div class="mx-auto max-w-4xl px-8 py-16 md:px-4">
      <div class="mb-20 text-center">
        <h1
          class="mb-4 text-5xl font-bold tracking-tight text-text-light md:text-6xl lg:text-7xl"
        >
          Welcome to the newsletter!
        </h1>
        <p
          class="mb-4 text-xl font-light text-light-pink md:text-2xl lg:text-3xl"
        >
          So excited you're here 🎉
        </p>
      </div>

      <div class="my-16 rounded-lg border-2 border-light-blue bg-light-blue/10 p-8 text-center">
        <p class="mb-4 text-lg font-semibold text-light-blue">Come say hi 👋</p>
        <div class="flex justify-center gap-6">
          <a
            href="https://www.linkedin.com/in/jaclynlilly/"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block rounded-lg border-2 border-light-blue bg-light-blue px-6 py-2 font-semibold text-dark-gray no-underline transition-all duration-300 ease-in-out hover:-translate-y-0.5 hover:bg-light-blue/90"
            >JL2💞</a
          >
          <a
            href="https://www.linkedin.com/in/stevenboutcher/"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block rounded-lg border-2 border-light-blue bg-light-blue px-6 py-2 font-semibold text-dark-gray no-underline transition-all duration-300 ease-in-out hover:-translate-y-0.5 hover:bg-light-blue/90"
            >SB🐒</a
          >
        </div>
      </div>

      <div class="mb-12">
        <h2
          class="mb-8 text-center text-3xl font-bold text-text-light md:text-4xl"
        >
          What You Have Access To ↓
        </h2>
      </div>

      <div class="mb-16">
        <ul class="mb-8 list-none">
          <li class="relative mb-6 pl-6">
            <span class="absolute left-0 font-bold text-light-pink">→</span>
            <strong class="mb-2 block text-lg text-light-pink"
              ><span class="text-light-pink">Idea Vault</span> 🗳️</strong
            >
            Want to steer the conversation? Tell us what topics or situations we should
            tackle next!
          </li>
          <li class="relative mb-6 pl-6">
            <span class="absolute left-0 font-bold text-light-pink">→</span>
            <strong class="mb-2 block text-lg text-light-pink"
              >The Insider Playbook on Winning Technical Job Orders 🧩</strong
            >
            Learn how we leverage engineering networks to validate roles and win technical
            searches others lose.
          </li>
          <li class="relative mb-6 pl-6">
            <span class="absolute left-0 font-bold text-light-pink">→</span>
            <strong class="mb-2 block text-lg text-light-pink"
              >Full access to all past issues 📚</strong
            >
            Dive into our complete archive of insights, strategies, and technical
            deep-dives whenever you need them.
          </li>
        </ul>
      </div>

      <div class="my-16 text-center">
        <div class="flex flex-col items-center gap-4 md:flex-row md:justify-center">
          <a
            class="inline-block animate-[shimmer_3s_linear_infinite] rounded-lg bg-gradient-to-r from-light-blue via-[#8dd5e8] to-light-blue bg-[length:200%_auto] px-12 py-4 text-xl font-bold text-dark-gray no-underline shadow-[0_4px_15px_rgba(171,232,247,0.4)] transition-all duration-300 ease-in-out hover:scale-105 hover:shadow-[0_6px_20px_rgba(171,232,247,0.6)]"
            href="https://docs.google.com/forms/d/e/1FAIpQLScidYRIslz7_yIjWc-fqaauhOlht4rPNgo-pa42KGn3se0KsQ/viewform?usp=header"
            target="_blank"
            rel="noopener noreferrer"
          >
            🗳️ Contribute to Idea Vault →
          </a>
          <a
            class="inline-block rounded-lg border-2 border-light-blue px-12 py-4 text-xl font-bold text-light-blue no-underline transition-all duration-300 ease-in-out hover:-translate-y-0.5 hover:border-light-blue hover:bg-light-blue/10"
            href="https://bettervetterletter.kit.com/profile"
            target="_blank"
            rel="noopener noreferrer"
          >
            📚 Browse Archive →
          </a>
        </div>
      </div>
    </div>
  </body>
</html>
